{
  "version": 1,
  "base_commit": "3cef7ef8abb644cb7ff9a8eaaaf7f14a0569a907",
  "description": "Twenty seeded regressions in pinned Orchestral production code. This is a controlled repository repair suite, not historical issue or cross-repository coverage. Two tasks span separate CLI processes with an inspect-only first turn.",
  "tasks": [
    {
      "id": "retry-backoff-cap",
      "category": "model-policy",
      "prompt": "Retry delays keep growing beyond the configured maximum. Restore bounded exponential backoff, including exhausted and disabled retry budgets.",
      "inspect_first": false,
      "mutations": [
        {
          "path": "core/orchestral-core/src/model_retry.rs",
          "before": ".min(self.max_delay_ms)",
          "after": ".min(u64::MAX)"
        }
      ],
      "checks": [
        {
          "package": "orchestral-core",
          "target": "lib",
          "filter": "model_retry::tests",
          "expected_tests": [
            "model_retry::tests::retry_policy_is_bounded_and_only_accepts_transient_errors",
            "model_retry::tests::invalid_delay_configuration_is_rejected"
          ]
        }
      ]
    },
    {
      "id": "retry-error-classification",
      "category": "model-policy",
      "prompt": "The retry policy retries permanent authentication failures and fails to retry temporary unavailability. Fix classification without making all errors retryable.",
      "inspect_first": false,
      "mutations": [
        {
          "path": "core/orchestral-core/src/model_retry.rs",
          "before": "ModelErrorCode::RateLimited | ModelErrorCode::Unavailable",
          "after": "ModelErrorCode::RateLimited | ModelErrorCode::Authentication"
        }
      ],
      "checks": [
        {
          "package": "orchestral-core",
          "target": "lib",
          "filter": "model_retry::tests",
          "expected_tests": [
            "model_retry::tests::retry_policy_is_bounded_and_only_accepts_transient_errors",
            "model_retry::tests::invalid_delay_configuration_is_rejected"
          ]
        }
      ]
    },
    {
      "id": "retry-invalid-configuration",
      "category": "model-policy",
      "prompt": "A zero base delay is accepted even though retry delays must be positive and bounded. Restore configuration validation.",
      "inspect_first": false,
      "mutations": [
        {
          "path": "core/orchestral-core/src/model_retry.rs",
          "before": "self.base_delay_ms == 0",
          "after": "self.base_delay_ms == u64::MAX"
        }
      ],
      "checks": [
        {
          "package": "orchestral-core",
          "target": "lib",
          "filter": "model_retry::tests",
          "expected_tests": [
            "model_retry::tests::retry_policy_is_bounded_and_only_accepts_transient_errors",
            "model_retry::tests::invalid_delay_configuration_is_rejected"
          ]
        }
      ]
    },
    {
      "id": "instructions-path-validation",
      "category": "instructions",
      "prompt": "Project instruction fallback names containing a drive prefix are accepted. Reject path-like fallback names while preserving ordinary filenames.",
      "inspect_first": false,
      "mutations": [
        {
          "path": "core/orchestral-core/src/project_instructions.rs",
          "before": "\n                || name.contains(':')",
          "after": ""
        }
      ],
      "checks": [
        {
          "package": "orchestral-project-instructions-fs",
          "target": "test:discovery",
          "filter": "fallback_names_cannot_escape_the_instruction_directory",
          "expected_tests": [
            "fallback_names_cannot_escape_the_instruction_directory"
          ]
        }
      ]
    },
    {
      "id": "instructions-worktree-boundary",
      "category": "instructions",
      "prompt": "Instruction discovery loses ancestor rules in Git worktrees whose .git entry is a file. Respect both Git directories and worktree pointers without importing rules above the project.",
      "inspect_first": false,
      "mutations": [
        {
          "path": "plugins/orchestral-project-instructions-fs/src/lib.rs",
          "before": "directory.join(\".git\").exists()",
          "after": "directory.join(\".git\").is_dir()"
        }
      ],
      "checks": [
        {
          "package": "orchestral-project-instructions-fs",
          "target": "test:discovery",
          "filter": "gitfile_boundary_excludes_parent_rules_and_empty_override_falls_back",
          "expected_tests": [
            "gitfile_boundary_excludes_parent_rules_and_empty_override_falls_back"
          ]
        }
      ]
    },
    {
      "id": "instructions-non-git-scope",
      "category": "instructions",
      "prompt": "Opening a non-Git scratch directory unexpectedly imports instructions from its parent. Keep non-Git discovery scoped to the selected directory.",
      "inspect_first": false,
      "mutations": [
        {
          "path": "plugins/orchestral-project-instructions-fs/src/lib.rs",
          "before": ".unwrap_or(&workspace)",
